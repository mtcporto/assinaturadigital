AUTH_GOOGLE_ID=google-client-id
AUTH_GOOGLE_SECRET=google-client-secret
AUTH_SECRET=independent-random-session-secret
RESEND_MODE=disabled
RESEND_ALLOW_LOCAL_LIVE=false
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=replace-me
# At least 32 random bytes as hex, independent from AUTH_SECRET
EVIDENCE_HMAC_KEY=replace-with-64-hex-chars
# Private Cloudflare R2 bucket, with scoped object read/write/delete credentials
R2_ACCOUNT_ID=cloudflare-account-id
R2_BUCKET=assinaturadigital-documents
R2_ACCESS_KEY_ID=r2-token-access-key
R2_SECRET_ACCESS_KEY=r2-token-secret-key

# Exact production origin and matching RP ID; configure in Vercel
WEBAUTHN_ORIGIN=https://assinaturadigital-two.vercel.app
WEBAUTHN_RP_ID=assinaturadigital-two.vercel.app
